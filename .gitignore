# ===========================================================================
# Entorno Python
# ===========================================================================
.venv/
venv/
__pycache__/
*.pyc

# ===========================================================================
# Credenciales (nunca versionar secretos reales)
# ===========================================================================
.env

# ===========================================================================
# Sistema
# ===========================================================================
.DS_Store

# ===========================================================================
# Artefactos ML
# Los *_v1.pkl se regeneran ejecutando: python src/03_compare_train_models.py
# Se versiona ÚNICAMENTE el modelo campeón (8.6 MB) para poder desplegar
# la aplicación sin necesidad de reentrenar.
# ===========================================================================
models/*
!models/champion_model.pkl

# ===========================================================================
# Datos
# Se versiona el CSV crudo original (dataset público de Kaggle, 110.527
# registros) para que el pipeline sea 100% replicable desde cero.
# Cualquier otro archivo de datos queda fuera del repositorio.
# ===========================================================================
data/*
!data/raw/
data/raw/*
!data/raw/citas_medicas_raw.csv

# ===========================================================================
# Documentos de entrega y defensa (fuera del repositorio: solo el proyecto)
# El informe CPP2 se entrega por separado (notebook/HTML/ODT/DOCX) y el
# material de defensa es interno del equipo.
# ===========================================================================
docs/exposicion/
notebook/01_informe_cpp2_ejecutable.ipynb
informe_cpp2_ejecutable.html
