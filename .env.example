# ===========================================================================
# Credenciales de Supabase (Settings -> API en el dashboard de tu proyecto)
# 1. Copia este archivo como .env:  cp .env.example .env
# 2. Reemplaza los valores con los de TU proyecto. NUNCA subas el .env a git.
# ===========================================================================
# SUPABASE_URL: URL de tu proyecto (formato: https://<project-ref>.supabase.co)
# SUPABASE_KEY: clave anon/publishable (respeta RLS) o clave secreta
#               sb_secret_... (bypasa RLS, solo para scripts ETL locales)
# ===========================================================================

SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=tu_clave_aqui

# Además, en Settings -> API -> "Exposed schemas in API", expón los esquemas:
#   public, bronze, silver, gold, meta
